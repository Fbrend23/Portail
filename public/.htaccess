# Déployé avec le site (copié de public/ vers dist/ par Vite).

# --- Une seule adresse : https://brendanfleurdelys.ch ---
# Sans ça, http://, https:// et www. répondent tous en 200 : Google voit
# plusieurs copies de la même page.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www. → sans www (et en HTTPS au passage)
  RewriteCond %{HTTP_HOST} ^www\.brendanfleurdelys\.ch$ [NC]
  RewriteRule ^ https://brendanfleurdelys.ch%{REQUEST_URI} [L,R=301]

  # http:// → https://
  # L'hébergeur peut terminer le TLS devant Apache : on teste aussi
  # X-Forwarded-Proto pour ne pas rediriger en boucle.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- Scrapers : 403 ---
  # Tencent Cloud se fait passer pour Safari iOS 13.2.3 (UA figé ; plus aucun
  # vrai iPhone ne tourne en 13.2.3). Les autres ignorent robots.txt.
  RewriteCond %{HTTP_USER_AGENT} "iPhone OS 13_2_3" [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (Bytespider|PetalBot|MJ12bot|DotBot) [NC]
  RewriteRule ^ - [F,L]

  # --- Langue : / → /en/ si le navigateur ne demande pas le français ---
  # Pas de choix explicite (cookie lang posé par LangSwitch) et un Accept-Language
  # présent : les robots sans en-tête restent sur la version fr (x-default).
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)lang=
  RewriteCond %{HTTP:Accept-Language} .
  RewriteCond %{HTTP:Accept-Language} !^\s*fr [NC]
  RewriteRule ^$ /en/ [R=302,L]
</IfModule>

# --- Page d'erreur aux couleurs du site pour les adresses inexistantes ---
ErrorDocument 404 /404.html

# --- Cache navigateur ---
<IfModule mod_headers.c>
  # Toujours revalider la page : c'est elle qui pointe vers les nouveaux bundles
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Bundles Vite empreintés (app-XXXXXXXX.js) : le nom change avec le contenu
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images et icônes : noms fixes, contenu qui peut changer → un jour
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # --- En-têtes de sécurité ---
  # (HSTS et la compression sont déjà gérés par l'hébergeur)
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Anti-clickjacking seul : une CSP complète casserait GoatCounter et les styles inline
  Header set Content-Security-Policy "frame-ancestors 'none'"
</IfModule>
